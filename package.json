{
  "name": "dsh-xb-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Xiaobo (小博) plugin collection for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
